{
  "name": "@itslezhi/dsh-chatseek",
  "version": "0.1.0",
  "private": true,
  "description": "Use local ChatSeek WeChat search, synchronization and history export in DeepSeek Harness.",
  "license": "MIT",
  "repository": "github:itslezhi/chatseek",
  "engines": { "node": ">=24.9.0", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "exports": {
    ".": "./integrations/deepseek-harness/index.mjs",
    "./locale/*.json": "./integrations/deepseek-harness/locale/*.json",
    "./icon": "./web/assets/chatseek-mark.svg"
  },
  "files": ["integrations/deepseek-harness", "web/assets/chatseek-mark.svg"],
  "dsh": { "bundle": { "patch": "./integrations/deepseek-harness/cordis.patch.yml" } },
  "scripts": { "test": "node --test tests/test_harness.mjs tests/test_stream_transport.js tests/test_setup_flow.js" },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  }
}
