# Copy to .env and configure your own Chat Completions-compatible model service.
# You can also save these settings from the local web interface.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Optional: leave empty when the service/model does not support image input.
LLM_VISION_MODEL=
LLM_CONTEXT_TOKENS=128000
LLM_MAX_OUTPUT_TOKENS=8192
# Set false only when the provider does not accept response_format=json_object.
LLM_JSON_MODE=true
# Legacy DEEPSEEK_* settings remain supported. No project relay is used by default.
CHATSEEK_USE_BETA_GATEWAY=0
